# The worker image for React web tasks.
#
# Identical to Dockerfile.worker.node in every way that is not the React
# toolchain: same base, same Node 22, same entrypoint shim, same uid, same
# absence of credentials. Read Dockerfile.worker first, then that one -
# everything they say about disposability, redaction and why Ollama is not in
# here applies unchanged.
#
# **Why React does not share the Node image.** It did, and it could not work:
# `node --test` has no JSX transform, so the shared image could run a React
# project's files only as syntax errors. What React needs is a transform and a
# DOM, and neither is in the Node image.
#
# **Why the toolchain is no longer baked in here, which reverses what this file
# used to argue.** It used to install `REACT_TOOLCHAIN` at build time and copy
# the result to `/node_modules`, on the reasoning that an image with a toolchain
# needs no registry at run time - true, and it cost more than it saved. The
# resolver walks parent directories, so a package baked at the filesystem root
# resolves from any checkout below it *whether or not the project declares it*.
# A worker could import a package, never declare it, pass its own gate, and open
# a pull request that CI - which installs what the project declares - could not
# build. Measured on run `to-do-react-generated-app-20260821-151111-95rff7`, PR
# 11: 34 tests passing in the worker, and one suite on the runner unable to
# resolve `@testing-library/user-event`, a package this image had and the
# project's manifest did not. The worker had written correct code and was told
# it had failed, three times, until a human was called.
#
# So the image ships node, npm and git, and nothing about React at all. The
# project's `package.json` - generated from `stacks.REACT_TOOLCHAIN` by
# `greenfield.provision`, not invented by a model - is the single declaration,
# and `worker.entrypoint.install_dependencies` installs it before the gate runs.
# Worker-green and CI-green are then statements about the same dependency set,
# which is the only way either of them means anything.
#
# **What it costs, stated plainly.** Every attempt of every react task now pays
# a registry round trip instead of a build-time one. That is why the public
# registries are on the egress allowlist (`security.REGISTRY_HOSTS`, #295) and
# why an install failure that is not the manifest's fault is exit 2 and costs no
# attempt (`entrypoint.INSTALL_INFRASTRUCTURE_SIGNATURES`) - a transient 503
# must not spend one of three attempts on a task that was never broken.
#
# Measured on this image, on the `apiary-egress` network through the tinyproxy
# the worker actually uses, installing exactly what `stacks.react_manifest`
# declares: **21s**, and `vitest run` green afterwards with the project's
# `node_modules/.bin` appended to PATH. The image itself went from 887MB to
# 723MB. And the property the whole change is for, in the same container: a test
# importing a package the manifest does not declare fails the gate with
# **exit 1** and the message `Failed to resolve import "date-fns"` - the
# identical failure CI used to report after the worker had already passed. The
# worker now sees it on its own attempt, where it can fix it by declaring it.
#
# **`NODE_PATH` is not the way back.** Node's ESM resolver ignores it - it is
# CJS-only - so it could never have served a `"type": "module"` project, which
# is what a modern React project is. That was the reason the baked copy had to
# live at `/`, and it is worth keeping written down so nobody reintroduces the
# root install as a "fix" for a slow task.

FROM node:22-bookworm-slim AS node


FROM python:3.12-slim AS build

# Same interpreter as Dockerfile.worker on purpose - see its note. A bug that
# reproduces in one worker image and not the other is the thing to avoid.
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
# Provider extras are opt-in, so the default image stays local-only exactly as
# `README.md` promises. A remote worker needs its provider's client library
# *inside the container* - the credential gate (#269) and the model passed
# through `INHERITED_ENV` are both useless without it, which is how a Bedrock
# worker came to fail with Ollama's "invalid model name".
#   docker build --build-arg WORKER_EXTRAS=bedrock -f Dockerfile.worker -t apiary-worker .
ARG WORKER_EXTRAS=
RUN pip install ".${WORKER_EXTRAS:+[$WORKER_EXTRAS]}"


FROM python:3.12-slim AS runtime

LABEL org.apiary.stack="react"

# git: the worker's entire job is a clone/branch/commit/push cycle.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

# Node from the official image rather than from Debian's archive: bookworm
# ships Node 18, and copying the prefix is how the pin stays a pin. The
# generated CI workflow pins the same major (greenfield/provision.CI_SETUP), so
# a worker-green result and a CI-green result are talking about one runtime.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY --from=build /opt/venv /opt/venv

# No `/node_modules/.bin` here any more: there is no toolchain at the
# filesystem root to reach. The project's own `node_modules/.bin` is appended to
# `PATH` at gate time by `worker.entrypoint.verify_env`, which is where the
# checkout's path is known - and appended rather than prefixed for the reason
# this line used to give: npm fills `.bin` from every installed package's `bin`
# field, so a prefix would let any one of ~170 transitive packages ship a file
# called `git` and have the clone/branch/commit/push cycle - a process holding a
# push token - run it instead of the real one.
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

ENV OLLAMA_HOST=http://host.docker.internal:11434

ENV GIT_AUTHOR_NAME="apiary worker" \
    GIT_AUTHOR_EMAIL="worker@apiary.invalid" \
    GIT_COMMITTER_NAME="apiary worker" \
    GIT_COMMITTER_EMAIL="worker@apiary.invalid"

RUN useradd --create-home --uid 10001 apiary \
 && mkdir -p /workspace \
 && chown -R apiary:apiary /workspace /opt/venv

ENV HOME=/home/apiary

# `~/.npm` for the same reason Dockerfile.worker.node has it: npm writes a
# cache on *every* invocation, including ones that install nothing, and an
# unwritable cache directory fails the command rather than skipping the cache.
RUN mkdir -p /home/apiary/.npm \
 && chown -R apiary:apiary /home/apiary
ENV NPM_CONFIG_CACHE=/home/apiary/.npm

# The same shim as Dockerfile.worker, and it must stay the same: the
# orchestrator dispatches one argv against every worker image, so a shim that
# drifted between them would be a stack-dependent argument contract.
COPY --chmod=0755 <<'PY' /usr/local/bin/apiary-worker
#!/opt/venv/bin/python
"""Run the worker entrypoint, or explain that it has not been written yet.

See Dockerfile.worker for why this is a shim and why existence is checked with
find_spec rather than a try/except around the import.
"""

import importlib.util
import sys


def _entrypoint():
    try:
        found = importlib.util.find_spec("swarm.worker.entrypoint") is not None
    except ModuleNotFoundError:
        found = False
    if not found:
        return None
    from swarm.worker.entrypoint import main

    return main


def _not_implemented(argv):
    import argparse

    parser = argparse.ArgumentParser(
        prog="apiary-worker",
        description="Run one issue to a pull request, in an isolated container.",
    )
    parser.add_argument("--repo", required=True, help="clone URL of the target repository")
    parser.add_argument("--issue", type=int, required=True, help="issue number holding the task contract")
    parser.add_argument("--base-commit", required=True, help="commit the work branch starts from")
    parser.parse_args(argv)

    print(
        "apiary-worker: the worker entrypoint is not implemented in this image "
        "(swarm.worker.entrypoint, issue #16)",
        file=sys.stderr,
    )
    return 2


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    run = _entrypoint()
    return run(argv) if run is not None else _not_implemented(argv)


if __name__ == "__main__":
    raise SystemExit(main())
PY

USER apiary
WORKDIR /workspace

ENTRYPOINT ["apiary-worker"]
