# The worker image for Node tasks.
#
# It used to serve React web as well, and could not: `node --test` has no JSX
# transform, so this image can read a React project's files only as syntax
# errors. React has its own image now - see Dockerfile.worker.react, which is
# this file plus a React toolchain at the filesystem root.
#
# Identical to Dockerfile.worker in every way that is not the toolchain: same
# base, same entrypoint shim, same uid, same absence of credentials. Read that
# file first - everything it says about disposability, redaction and why Ollama
# is not in here applies unchanged.
#
# **Why a second image at all.** Dockerfile.worker's own comment argued for
# baking in no toolchain, on the grounds that "baking a stack in would quietly
# narrow the swarm to repos that happen to use that stack". The intent was
# stack-agnosticism and the effect was the opposite: baking *none* narrowed it
# to Python, because the one toolchain every image did carry was the Python the
# package itself needs. The same comment expected the verify command to
# "install whatever the target repo requires at run time", which it cannot - a
# worker sits on an internal network whose only route out is an egress proxy
# whose allowlist is a static block in compose.yaml, so `npm install` is denied
# in under a second (see swarm/worker/entrypoint.DENIED_EGRESS_SIGNATURES).
#
# So agnosticism is bought by *several* images selected per task (#99), not by
# an empty one. This is the second.
#
# **Node 22, pinned.** ubuntu-latest ships a Node and GitHub changes which one;
# an unpinned runtime is a gate that changes under the repository. The
# generated CI workflow pins the same major (greenfield/provision.CI_SETUP), so
# a worker-green result and a CI-green result are talking about one runtime.
#
# **No package manager beyond npm, and no packages.** #87's first non-Python
# stack is Node with `node --test` - stdlib since Node 18, no dependencies, no
# lockfile, no registry - precisely so this image needs nothing the egress
# policy forbids. A stack that does carry dependencies can still be built
# without widening anything; Dockerfile.worker.react is that argument, and it
# belongs in that file rather than this one.

FROM node:22-bookworm-slim AS node
FROM python:3.12-slim AS build

# Same interpreter as Dockerfile.worker on purpose - see its note. A bug that
# reproduces in one worker image and not the other is the thing to avoid.
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
# Provider extras are opt-in, so the default image stays local-only exactly as
# `README.md` promises. A remote worker needs its provider's client library
# *inside the container* - the credential gate (#269) and the model passed
# through `INHERITED_ENV` are both useless without it, which is how a Bedrock
# worker came to fail with Ollama's "invalid model name".
#   docker build --build-arg WORKER_EXTRAS=bedrock -f Dockerfile.worker -t apiary-worker .
ARG WORKER_EXTRAS=
RUN pip install ".${WORKER_EXTRAS:+[$WORKER_EXTRAS]}"


FROM python:3.12-slim AS runtime

LABEL org.apiary.stack="node"

# git: the worker's entire job is a clone/branch/commit/push cycle.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

# Node from the official image rather than from Debian's archive: bookworm
# ships Node 18, and copying the prefix is how the pin above stays a pin.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY --from=build /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

ENV OLLAMA_HOST=http://host.docker.internal:11434

ENV GIT_AUTHOR_NAME="apiary worker" \
    GIT_AUTHOR_EMAIL="worker@apiary.invalid" \
    GIT_COMMITTER_NAME="apiary worker" \
    GIT_COMMITTER_EMAIL="worker@apiary.invalid"

RUN useradd --create-home --uid 10001 apiary \
 && mkdir -p /workspace \
 && chown -R apiary:apiary /workspace /opt/venv

ENV HOME=/home/apiary

# `~/.npm` for the same reason /opt/venv is owned by apiary in Dockerfile.worker:
# npm writes a cache on *every* invocation, including ones that install nothing,
# and an unwritable cache directory fails the command rather than skipping the
# cache. Created and chowned at build time rather than left to first use,
# because uid 10001 cannot create it under a root-owned HOME.
RUN mkdir -p /home/apiary/.npm \
 && chown -R apiary:apiary /home/apiary
ENV NPM_CONFIG_CACHE=/home/apiary/.npm

# The same shim as Dockerfile.worker, and it must stay the same: the
# orchestrator dispatches one argv against every worker image, so a shim that
# drifted between them would be a stack-dependent argument contract.
COPY --chmod=0755 <<'PY' /usr/local/bin/apiary-worker
#!/opt/venv/bin/python
"""Run the worker entrypoint, or explain that it has not been written yet.

See Dockerfile.worker for why this is a shim and why existence is checked with
find_spec rather than a try/except around the import.
"""

import importlib.util
import sys


def _entrypoint():
    try:
        found = importlib.util.find_spec("swarm.worker.entrypoint") is not None
    except ModuleNotFoundError:
        found = False
    if not found:
        return None
    from swarm.worker.entrypoint import main

    return main


def _not_implemented(argv):
    import argparse

    parser = argparse.ArgumentParser(
        prog="apiary-worker",
        description="Run one issue to a pull request, in an isolated container.",
    )
    parser.add_argument("--repo", required=True, help="clone URL of the target repository")
    parser.add_argument("--issue", type=int, required=True, help="issue number holding the task contract")
    parser.add_argument("--base-commit", required=True, help="commit the work branch starts from")
    parser.parse_args(argv)

    print(
        "apiary-worker: the worker entrypoint is not implemented in this image "
        "(swarm.worker.entrypoint, issue #16)",
        file=sys.stderr,
    )
    return 2


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    run = _entrypoint()
    return run(argv) if run is not None else _not_implemented(argv)


if __name__ == "__main__":
    raise SystemExit(main())
PY

USER apiary
WORKDIR /workspace

ENTRYPOINT ["apiary-worker"]
